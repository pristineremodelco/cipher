# Kept here as well as in the repository root, so this directory is a whole
# project on its own and can be lifted out without leaving its rules behind.
node_modules
dist
dist-ssr
*.local

# Wrangler's local cache. The deploy itself uses dist.
.wrangler

*.log
npm-debug.log*

.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Written into the project folder by a local prompt hook. A private record
# of what was asked, and this repository is public.
PROMPT-LOG.md

# Android. The debug build uses the machine's debug keystore. A release
# keystore and its passwords stay out of the repository.
android/keystore.properties
*.keystore
*.jks
android/local.properties
android/.gradle
android/build
android/app/build
android/app/src/main/assets/public
android/capacitor-cordova-android-plugins/build
