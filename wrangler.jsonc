// Cipher on Cloudflare, as static files with no server code. The Cloudflare
// workflow builds without BASE_PATH, so the app is at the root of the
// workers.dev address. GitHub Pages builds its own copy for /cipher/.
{
  "name": "cipher",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
