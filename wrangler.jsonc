// Cipher on Cloudflare, as static files with no server code. `npm run build`
// first: left without BASE_PATH it builds for the root, which is what a
// workers.dev address serves. GitHub Pages builds its own copy for /cipher/.
{
  "name": "cipher",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
