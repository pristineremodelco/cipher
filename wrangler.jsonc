// Cipher on Cloudflare, as static files with no server code. The Cloudflare
// workflow builds without BASE_PATH, so the app is at the root of the
// workers.dev address. GitHub Pages builds its own copy for /cipher/.
{
  "name": "cipher",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Pull request and branch builds run `npx wrangler preview`. That command
  // requires this block. An empty block is enough. Cipher has no database
  // or secrets, so a preview is only the built static files.
  "previews": {}
}
